<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>

    <!-- Native AOT: no JIT, ahead-of-time compiled to a native binary. -->
    <PublishAot>true</PublishAot>
    <StripSymbols>true</StripSymbols>

    <!-- Throughput-oriented GC (matches a production high-load service). -->
    <ServerGarbageCollection>true</ServerGarbageCollection>
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
  </PropertyGroup>

  <ItemGroup>
    <!-- Raw Npgsql only: Dapper's runtime IL-emit mapping is not AOT-safe,
         and hand-mapped readers are the fastest, fully trim/AOT-safe path. -->
    <PackageReference Include="Npgsql" Version="9.0.3" />
  </ItemGroup>

</Project>
